# Frontend
# Must include the /api/v1 prefix. Leave empty to use in-memory demo mode.
VITE_API_BASE_URL=http://localhost:8787/api/v1
# Optional. Both must be set or the analytics script is omitted from the build.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# API
API_PORT=8787
CORS_ORIGIN=http://localhost:5173

# Database
# Copy this file to `.env` and replace the password placeholders locally.
# Docker Compose reads POSTGRES_* from `.env`. Do not commit `.env`.
POSTGRES_DB=bizcaiaos
POSTGRES_USER=bizcaiaos_owner
POSTGRES_PASSWORD=replace-with-local-owner-password
POSTGRES_PORT=5432
POSTGRES_APP_USER=bizcaiaos_app
POSTGRES_APP_PASSWORD=replace-with-local-app-password

# Runtime role: subject to RLS (not the table owner, no BYPASSRLS)
DATABASE_URL=postgresql://bizcaiaos_app:replace-with-local-app-password@127.0.0.1:5432/bizcaiaos
# Migration role: table owner / local superuser equivalent
DATABASE_MIGRATE_URL=postgresql://bizcaiaos_owner:replace-with-local-owner-password@127.0.0.1:5432/bizcaiaos
DATABASE_POOL_SIZE=10
DATABASE_SSL=

# JWT / JWKS — identifiers only; do not put private keys here
AUTH_JWKS_URL=https://YOUR_ISSUER/.well-known/jwks.json
AUTH_ISSUER=https://YOUR_ISSUER
AUTH_AUDIENCE=YOUR_API_AUDIENCE

# Document storage
# "local" is the only implemented provider. Development/test only -- files on
# local disk do not survive redeploys on most container/PaaS platforms. A
# production storage adapter is not implemented until a deployment target is
# confirmed (see docs/domain-model.md and the Documents technical contract).
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_LOCAL_ROOT=./.data/documents
# 25 MB default
DOCUMENT_MAX_SIZE_BYTES=26214400
DOCUMENT_ACCEPTED_MIME_TYPES=application/pdf,image/jpeg,image/png,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
