# BizcaiaOS STAGING configuration template. Placeholders only: never put real
# values in this file or in Git. Real values live in the Render dashboard
# (Static Site / Web Service environment) and the operator's secret store.
# Check a filled-in environment with:
#   npm run config:check -- --target staging --scope frontend   (Static Site)
#   npm run config:check -- --target staging --scope api        (Web Service)
#   npm run config:check -- --target staging --scope migration  (operator)
# See docs/deployment/production-readiness.md.

# --- Frontend: Render Static Site (PUBLIC, build time; baked into dist/) ---
NODE_VERSION=24
VITE_API_BASE_URL=https://api-staging.<domain>/api/v1
VITE_SUPABASE_URL=https://<staging-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<staging publishable key>

# --- API: Render Web Service (runtime) ---
NODE_ENV=production
NODE_VERSION=24
API_PORT=10000
CORS_ORIGIN=https://staging.<domain>
# SECRET: bizcaiaos_app connection (TLS). Set in the Render dashboard only.
DATABASE_URL=<secret>
DATABASE_SSL=require
AUTH_ISSUER=https://<staging-project-ref>.supabase.co/auth/v1
AUTH_AUDIENCE=authenticated
AUTH_JWKS_URL=https://<staging-project-ref>.supabase.co/auth/v1/.well-known/jwks.json
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_LOCAL_ROOT=/var/data/documents

# --- Migration: operator session only, never on Render ---
# SECRET: bizcaiaos_migrator connection, direct or session pooler (port 5432), sslmode=require.
DATABASE_MIGRATE_URL=<secret>
POSTGRES_APP_USER=bizcaiaos_app
