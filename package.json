{
  "name": "bizcaiaos-ops-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "start:api": "tsx server/index.ts",
    "typecheck:api": "tsc -p tsconfig.server.json --noEmit",
    "test:api": "vitest run server --environment node --exclude server/integration/**",
    "test:frontend": "vitest run src",
    "test:frontend:watch": "vitest src",
    "test:frontend:coverage": "vitest run src --coverage",
    "test": "npm run test:frontend && npm run test:api",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && npm run db:migrate",
    "db:migrate": "tsx server/migrate.ts",
    "test:integration": "vitest run server/integration --environment node"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-react": "0.544.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
}
